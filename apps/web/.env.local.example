# Lua agent integration — copy this file to `.env.local` and fill in real values.
# `apps/web/app/api/assessment/route.ts` reads these at runtime.

# The agent ID returned by `lua deploy` (run from `apps/lua-agent/`).
# Looks like a UUID — printed at the end of a successful deploy.
LUA_AGENT_ID=

# Lua personal API key. Two ways to get it:
#   1. Run `lua auth configure` once — the CLI writes it to ~/.lua-cli/credentials,
#      and you can `cat` it from there.
#   2. Or grab it from the Lua dashboard: https://app.heylua.ai → Account → API keys.
LUA_API_KEY=

# Optional: override the Lua API base URL. Defaults to https://api.heylua.ai.
# LUA_API_URL=https://api.heylua.ai

# Optional: which channel the route reports as. Defaults to `dev`.
# Production traffic for end users should probably move to `web` once the agent is verified.
# LUA_CHANNEL=dev
</content>
</invoke>