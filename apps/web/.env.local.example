# Local dev env — copy this file to `.env.local` and fill in real values.
# Both `apps/web/app/api/assessment/_agent/` and
# `apps/web/app/api/study-plan/_agent/` read these at runtime.

# OpenRouter API key powers the in-process LangGraph agent (assessment
# commentary + study-plan generation). Grab one from https://openrouter.ai
# → Account → Keys.
OPENROUTER_API_KEY=

# Optional: override the model. Defaults to `anthropic/claude-haiku-4.5`,
# which has strong JSON-mode compliance and reliable reasoning on short turns.
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5
