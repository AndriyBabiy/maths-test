# Copy this file to `.env.local` and fill in real values.
# The diagnostic agent at `app/api/assessment/_agent/` reads these at runtime.

# OpenRouter API key. Sign up at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# OpenRouter model slug. Defaults to anthropic/claude-haiku-4.5 if unset.
OPENROUTER_MODEL=

# --- PostHog analytics ---------------------------------------------------
# Single PostHog project key shared across every andriybabiy.com subdomain
# (maths-test, studyie, portfolio, …). Cross-subdomain identity follows the
# user automatically because the cookie is scoped to `.andriybabiy.com`.
# Use the EU cloud project (https://eu.posthog.com) for GDPR locality.
NEXT_PUBLIC_POSTHOG_KEY=

# Defaults to the EU cloud ingest origin. Override only if self-hosting.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Server-side PostHog write key (used by route handlers + LLM observability).
# Same project as NEXT_PUBLIC_POSTHOG_KEY in PostHog Cloud — but kept as a
# separate var so it's never exposed to the browser bundle.
POSTHOG_API_KEY=
