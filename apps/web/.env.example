# Copy this file to `.env.local` and fill in real values.
# The diagnostic agent at `app/api/assessment/_agent/` reads these at runtime.

# OpenRouter API key. Sign up at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# OpenRouter model slug. Defaults to anthropic/claude-sonnet-4-6 if unset.
OPENROUTER_MODEL=
