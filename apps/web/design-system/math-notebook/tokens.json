{
  "$schema": "https://ui-ux-pro-max.dev/tokens.schema.json",
  "schemaVersion": "2.1.0",
  "project": "Math Notebook",
  "aesthetic": "modern, clean adaptive maths assessment — Inter typography, zinc neutral surface, indigo accent, flat cards with subtle shadow elevation",
  "inspiration": "responsive-utility-saas",
  "stage": {
    "width": 1280,
    "height": 800,
    "scaleStrategy": "fit: scale = min(vw/1280, vh/800, 2) — capped at 2× so canvas does not pixelate on 4K. Below md (768px) the stage flows to a single-column stack instead of scaling, so questions and choices remain legible without zoom."
  },
  "breakpoints": {
    "sm": 375,
    "md": 768,
    "lg": 1024,
    "xl": 1280
  },
  "media": {
    "sm": "@media (min-width: 375px)",
    "md": "@media (min-width: 768px)",
    "lg": "@media (min-width: 1024px)",
    "xl": "@media (min-width: 1280px)",
    "touch": "@media (hover: none) and (pointer: coarse)",
    "pointer": "@media (hover: hover) and (pointer: fine)",
    "reducedMotion": "@media (prefers-reduced-motion: reduce)"
  },
  "tap": {
    "touch": 44,
    "pointer": 32,
    "rationale": "WCAG 2.5.5 target size: 44×44 CSS px on coarse-pointer devices; relaxed to 32 px on fine-pointer for density."
  },
  "fontSizeFluid": {
    "micro": "clamp(10px, 0.625rem + 0.1vw, 12px)",
    "tiny": "clamp(11px, 0.6875rem + 0.1vw, 13px)",
    "small": "clamp(12px, 0.75rem + 0.1vw, 14px)",
    "body": "clamp(13px, 0.8125rem + 0.15vw, 16px)",
    "bodyLg": "clamp(14px, 0.875rem + 0.15vw, 17px)",
    "label": "clamp(12px, 0.75rem + 0.1vw, 14px)",
    "lead": "clamp(15px, 0.9375rem + 0.2vw, 18px)",
    "h4": "clamp(15px, 0.9375rem + 0.25vw, 19px)",
    "h3": "clamp(17px, 1.0625rem + 0.4vw, 22px)",
    "h2": "clamp(20px, 1.25rem + 0.6vw, 28px)",
    "h1": "clamp(24px, 1.5rem + 1vw, 36px)",
    "celebration": "clamp(40px, 2.5rem + 3vw, 72px)"
  },
  "spaceFluid": {
    "0": "0px",
    "1": "clamp(2px, 0.125rem + 0.05vw, 4px)",
    "2": "clamp(3px, 0.1875rem + 0.05vw, 6px)",
    "3": "clamp(4px, 0.25rem + 0.1vw, 8px)",
    "4": "clamp(6px, 0.375rem + 0.15vw, 12px)",
    "5": "clamp(8px, 0.5rem + 0.25vw, 16px)",
    "6": "clamp(12px, 0.75rem + 0.4vw, 22px)",
    "7": "clamp(14px, 0.875rem + 0.5vw, 28px)",
    "8": "clamp(16px, 1rem + 0.75vw, 36px)",
    "10": "clamp(20px, 1.25rem + 1vw, 48px)",
    "12": "clamp(24px, 1.5rem + 1.25vw, 60px)",
    "16": "clamp(32px, 2rem + 2vw, 80px)"
  },
  "containerWidth": {
    "sm": 480,
    "md": 720,
    "lg": 960,
    "xl": 1200,
    "xxl": 1440
  },
  "responsiveLayout": {
    "stageGrid": {
      "below_md": "single column · question + choices stack on top of workings; chat collapses into a slide-over",
      "md_to_lg": "two columns · contents drawer + main pad (chat above, workings below) · 1fr 1.4fr",
      "lg_and_up": "three columns · 264px 1fr 1.4fr (current desktop layout)"
    },
    "rules": [
      "Below md, replace fixed 1280×800 art-board scaling with `width: 100%; min-height: 100dvh` so each pane gets a normal scroll surface.",
      "Touch targets must read from `tap.touch` (44px) when `media.touch` matches; from `tap.pointer` (32px) otherwise.",
      "Preserve `letter-spacing: -0.02em` on h1/h2 only — body remains 0.",
      "Always pair `fontSizeFluid` with `lineHeight: 1.5` for body and `1.2` for headings."
    ]
  },
  "color": {
    "bg": {
      "canvas": "#fafafa",
      "surface": "#ffffff",
      "muted": "#f4f4f5",
      "subtle": "#f9fafb",
      "inverse": "#18181b"
    },
    "border": {
      "subtle": "#f1f5f9",
      "default": "#e4e4e7",
      "strong": "#d4d4d8",
      "focus": "#6366f1"
    },
    "ink": {
      "primary": "#18181b",
      "secondary": "#3f3f46",
      "muted": "#52525b",
      "soft": "#71717a",
      "faint": "#a1a1aa",
      "onAccent": "#ffffff"
    },
    "accent": {
      "primary": "#4f46e5",
      "primaryHover": "#4338ca",
      "primarySoft": "#eef2ff",
      "primaryEdge": "#c7d2fe",
      "primaryInk": "#3730a3"
    },
    "feedback": {
      "goodBg": "#ecfdf5",
      "goodInk": "#047857",
      "goodEdge": "#a7f3d0",
      "warnBg": "#fffbeb",
      "warnInk": "#b45309",
      "warnEdge": "#fcd34d",
      "badBg": "#fef2f2",
      "badInk": "#b91c1c",
      "badEdge": "#fecaca",
      "infoBg": "#eff6ff",
      "infoInk": "#1d4ed8",
      "infoEdge": "#bfdbfe"
    },
    "pen": {
      "black": "#18181b",
      "blue": "#2563eb",
      "red": "#dc2626",
      "green": "#059669",
      "amber": "#d97706"
    }
  },
  "typography": {
    "families": {
      "sans": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "display": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "handwrite": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "ui-monospace, SFMono-Regular, 'JetBrains Mono', Menlo, monospace"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "micro": 11,
      "tiny": 12,
      "small": 13,
      "body": 14,
      "bodyLg": 15,
      "label": 13,
      "lead": 16,
      "h4": 17,
      "h3": 20,
      "h2": 24,
      "h1": 32,
      "celebration": 64
    },
    "lineHeight": {
      "tight": 1.2,
      "snug": 1.4,
      "body": 1.55,
      "relaxed": 1.7
    },
    "googleFontsImport": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
  },
  "space": {
    "0": 0,
    "1": 2,
    "2": 4,
    "3": 6,
    "4": 8,
    "5": 12,
    "6": 16,
    "7": 20,
    "8": 24,
    "10": 32,
    "12": 40,
    "16": 56
  },
  "radius": {
    "xs": 4,
    "sm": 6,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "pill": 999
  },
  "shadow": {
    "xs": "0 1px 2px rgba(15, 23, 42, 0.04)",
    "sm": "0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04)",
    "md": "0 4px 12px rgba(15, 23, 42, 0.06), 0 2px 4px rgba(15, 23, 42, 0.04)",
    "lg": "0 12px 32px rgba(15, 23, 42, 0.08), 0 4px 8px rgba(15, 23, 42, 0.04)",
    "focus": "0 0 0 3px rgba(99, 102, 241, 0.2)"
  },
  "motion": {
    "fast": "120ms cubic-bezier(0.4, 0, 0.2, 1)",
    "base": "200ms cubic-bezier(0.4, 0, 0.2, 1)",
    "slow": "320ms cubic-bezier(0.4, 0, 0.2, 1)",
    "celebrationKeyframe": "mn-pop 1.1s cubic-bezier(0.4, 0, 0.2, 1) forwards"
  },
  "touch": {
    "minTarget": 36,
    "preferredTarget": 44
  },
  "patterns": {
    "card": {
      "background": "color.bg.surface",
      "border": "1px solid color.border.default",
      "radius": "radius.lg",
      "elevation": "shadow.xs"
    },
    "buttonPrimary": {
      "background": "color.accent.primary",
      "hoverBackground": "color.accent.primaryHover",
      "color": "color.ink.onAccent",
      "radius": "radius.md"
    },
    "buttonSecondary": {
      "background": "color.bg.surface",
      "border": "1px solid color.border.default",
      "activeBackground": "color.accent.primarySoft",
      "color": "color.ink.primary",
      "radius": "radius.md"
    },
    "chatBubbleTutor": {
      "background": "color.bg.surface",
      "border": "1px solid color.border.default",
      "radius": 14,
      "tipRadius": 4
    },
    "chatBubbleYou": {
      "background": "color.accent.primary",
      "color": "color.ink.onAccent",
      "radius": 14,
      "tipRadius": 4
    },
    "feedbackRibbon": {
      "radius": "radius.pill",
      "padding": "4px 12px",
      "fontSize": "fontSize.tiny"
    }
  },
  "layout": {
    "topBar": { "minHeight": 56, "padding": "12px 24px" },
    "footer": { "padding": "10px 24px" },
    "stageGrid": "264px 1fr 1.4fr"
  },
  "iconography": {
    "rule": "Use Lucide-style line glyphs on a 24×24 viewBox with 1.6px stroke and rounded line caps. No emojis as UI chrome. Emojis are allowed only as user-authored content inside chat bubbles."
  },
  "antiPatterns": [
    "Do not introduce dark-mode chrome — assessment surface stays light.",
    "Do not use emojis as UI icons — Lucide-style 24×24 SVGs only.",
    "Do not reintroduce hand-drawn pencil aesthetic, Caveat/Kalam fonts, dashed pencil borders, or jittered SketchBox SVG paths.",
    "Do not wrap content in dark-wood letterbox frames.",
    "Do not use scale transforms that shift layout on hover — use color/opacity transitions only."
  ]
}
