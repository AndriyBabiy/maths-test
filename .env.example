# Production deploy env — lives at /opt/maths-test/.env on the VPS, never committed.
# Loaded by docker-compose.yml. chmod 600 after editing.

# Public hostname Caddy serves and obtains a Let's Encrypt cert for.
DOMAIN=maths-test.andriybabiy.com

# Used by Let's Encrypt for expiry notifications.
ACME_EMAIL=andriybabiy97@gmail.com

# Lua agent credentials — copy from heylua.ai dashboard.
# LUA_AGENT_ID matches `agentId` in apps/lua-agent/lua.skill.yaml.
LUA_AGENT_ID=baseAgent_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LUA_API_KEY=api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides — defaults match production.
LUA_API_URL=https://api.heylua.ai
LUA_CHANNEL=web
