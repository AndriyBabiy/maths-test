# Production deploy env — lives at /opt/maths-test/.env on the VPS, never committed.
# Loaded by docker-compose.yml. chmod 600 after editing.
#
# TLS / hostname is handled by the host nginx + shared Cloudflare Origin Cert,
# so we don't need DOMAIN / ACME_EMAIL here.

# OpenRouter API key — powers the in-process LangGraph assessment agent and
# the study-plan generator. Grab from https://openrouter.ai → Account → Keys.
OPENROUTER_API_KEY=

# Optional: override the model. Defaults to `anthropic/claude-haiku-4.5`.
# OPENROUTER_MODEL=anthropic/claude-haiku-4.5
